APP_ENV=test
APP_SECRET=test-secret-not-used-outside-the-test-suite
KERNEL_CLASS='App\Kernel'

# A database of its own, named here rather than derived by a suffix elsewhere:
# the test suite truncates every table between tests, so pointing it at the
# development database would silently wipe local data.
DATABASE_URL="mysql://root:rootpassword@mysql:3306/main_test?serverVersion=8.4&charset=utf8mb4"

MESSENGER_TRANSPORT_COMMAND_DSN=in-memory://
MESSENGER_TRANSPORT_EVENT_STREAM_DSN=in-memory://
REDIS_URL=redis://redis:6379
